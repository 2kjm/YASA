{
  "name": "support-guide",
  "description": "Explains a triaged ticket to the on-call human; drafts a clarifying reply that waits for approval.",
  "manifest": {
    "model": {
      "name": "$GUIDE_MODEL",
      "params": {
        "temperature": 0.2
      }
    },
    "instructions": "@prompts/guide.md",
    "mcp_servers": [
      {
        "name": "freshdesk",
        "enable_tools": [
          "start_conversation",
          "fetchSearchTickets",
          "fetchTicket",
          "fetchTicketConversations",
          "replyTicket",
          "updateTicket"
        ],
        "require_approval_for_tools": [
          "replyTicket",
          "updateTicket"
        ]
      },
      {
        "name": "sentry",
        "enable_tools": [
          "@read-only"
        ]
      },
      {
        "name": "notion",
        "enable_tools": [
          "notion-search",
          "notion-fetch",
          "notion-query-data-sources"
        ]
      },
      {
        "name": "slack",
        "enable_tools": [
          "conversations_replies",
          "conversations_history"
        ]
      }
    ],
    "config": {
      "sandbox": {
        "enabled": true
      },
      "ask_user_questions": {
        "enabled": true
      }
    }
  }
}
