# Copy to .env and fill in. Never commit .env.
# The model key is NOT here: add it in TrueForge -> Settings -> Model providers.

# Base inbox for demo customers; scripts use plus-addresses of it (you+cafemocha@..., you+spam@...).
DEMO_EMAIL_BASE=you@example.com

# Sentry -> Project settings -> Client Keys (DSN)
SENTRY_DSN=


# Slack bot token (xoxb-...) and the #support-help channel id (C...)
SLACK_MCP_XOXB_TOKEN=
SLACK_MCP_ADD_MESSAGE_TOOL=

TRUEFORGE_URL=http://localhost:8790

# Model names as TrueForge lists them after you add a provider (Settings -> Model providers), "provider/model"
TRIAGE_MODEL=
GUIDE_MODEL=

# Freshdesk (support desk). API key: Freshdesk -> Profile settings -> View API key
FRESHDESK_DOMAIN=yourcompany.freshdesk.com
FRESHDESK_API_KEY=
